---
import { Image } from 'astro:assets';
import portrait from '../assets/anton-portrait.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from './Arrow.astro';
import ProjectVisual from './ProjectVisual.astro';
import { content, type Locale } from '../content';
import { profile } from '../data/profile';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];
const es = locale === 'es';
const year = new Date().getFullYear();
---

<BaseLayout locale={locale} {...t.meta}>
  <a class="skip-link" href="#main">
    {t.skip}
  </a>
  <div class="site-shell" id="top">
    <header class="site-header wrap">
      <a class="wordmark" href={es ? '/es/' : '/'} aria-label="Anton Andropov">
        <span class="wordmark-symbol" aria-hidden="true">
          a.
        </span>
        <span>Anton Andropov</span>
      </a>
      <nav
        class="main-nav"
        aria-label={es ? 'Navegación principal' : 'Main navigation'}
      >
        <a href="#about">{t.nav.about}</a>
        <a href="#work">{t.nav.work}</a>
        <a href="#contact">
          {t.nav.contact} <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <nav class="language-switch" aria-label={es ? 'Idioma' : 'Language'}>
        <a
          href="/"
          lang="en"
          hreflang="en"
          aria-label="English"
          aria-current={!es ? 'page' : undefined}
          data-language
        >
          EN
        </a>
        <span aria-hidden="true">/</span>
        <a
          href="/es/"
          lang="es"
          hreflang="es"
          aria-label="Español"
          aria-current={es ? 'page' : undefined}
          data-language
        >
          ES
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="small-star" aria-hidden="true">
              ✳
            </span>{' '}
            {t.hero.eyebrow}
          </p>
          <h1 id="hero-title">
            Anton
            <br />
            Andropov<span class="name-dot">.</span>
          </h1>
          <p class="hero-headline">
            {es ? 'Full-stack.' : 'Full-stack.'}{' '}
            <span>{es ? 'Especializado en backend.' : 'Backend-focused.'}</span>
          </p>
          <p class="hero-intro">{t.hero.intro}</p>
          <div class="hero-actions">
            <a class="button-primary" href="#work">
              {t.hero.cta}
              <Arrow />
            </a>
            <a class="text-link" href="#contact">
              {t.hero.secondary}
              <Arrow diagonal />
            </a>
          </div>
          <p class="hero-location">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
              <circle cx="12" cy="10" r="2" />
            </svg>
            {t.hero.location}
          </p>
        </div>
        <div class="hero-scene">
          <div class="nebula-cloud cloud-one" aria-hidden="true"></div>
          <div class="nebula-cloud cloud-two" aria-hidden="true"></div>
          <div class="nebula-cloud cloud-three" aria-hidden="true"></div>
          <div class="starfield" aria-hidden="true"></div>
          <div class="celestial-orbit" aria-hidden="true"></div>
          <div class="celestial-orbit orbit-secondary" aria-hidden="true"></div>
          <div class="portrait-space">
            <Image
              class="hero-portrait"
              src={portrait}
              alt={t.portraitAlt}
              widths={[320, 480, 640, 800]}
              sizes="(max-width: 767px) 85vw, 480px"
              loading="eager"
              fetchpriority="high"
              quality={85}
            />
          </div>
          <div class="geometry geometry-top" aria-hidden="true">
            <svg
              viewBox="0 0 100 100"
              fill="none"
              stroke="currentColor"
              stroke-width=".8"
            >
              <path d="m50 5 43 25v45L50 100 7 75V30L50 5Zm0 0v50m43-25L50 55 7 30m43 25v45" />
            </svg>
          </div>
          <span class="scene-star star-one" aria-hidden="true">
            ✧
          </span>
          <span class="scene-star star-two" aria-hidden="true">
            +
          </span>
          <span class="scene-star star-three" aria-hidden="true">
            ✧
          </span>
          <span class="scene-coordinate" aria-hidden="true">
            36°43′ N &nbsp; 4°25′ W
          </span>
        </div>
        <div class="hero-bottom">
          <span>
            {es
              ? 'Código con intención. Productos con sentido.'
              : 'Thoughtful code. Purposeful products.'}
          </span>
          <a href="#about" aria-label={t.nav.about}>
            <span aria-hidden="true">↓</span>
          </a>
          <span class="hero-index" aria-hidden="true">
            01 — 05
          </span>
        </div>
      </section>
      <section
        id="about"
        class="about-section wrap section"
        aria-labelledby="about-title"
      >
        <div class="section-marker">
          <span aria-hidden="true">01 /</span>
          <p class="eyebrow">{t.about.eyebrow}</p>
        </div>
        <div class="about-content">
          <h2 id="about-title">{t.about.title}</h2>
          <p>{t.about.body}</p>
          <div class="about-note">
            <span class="note-line" aria-hidden="true"></span>
            <span>TypeScript / Node.js / PHP</span>
          </div>
        </div>
      </section>
      <section
        id="work"
        class="work-section wrap section"
        aria-labelledby="work-title"
      >
        <div class="section-marker">
          <span aria-hidden="true">02 /</span>
          <p class="eyebrow">{t.work.eyebrow}</p>
        </div>
        <div class="section-heading">
          <h2 id="work-title">{t.work.title}</h2>
          <p>{t.work.intro}</p>
        </div>
        <div class="projects">
          {t.projects.map((project, i) => (
            <article
              class="project-entry"
              aria-labelledby={`project-${project.id}`}
            >
              <div class="project-copy">
                <p class="project-category">
                  <span class="project-number" aria-hidden="true">
                    0{i + 1}
                  </span>
                  {project.category}
                </p>
                <h3 id={`project-${project.id}`}>{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <p class="project-contribution">{project.contribution}</p>
                <ul
                  class="stack-tags"
                  aria-label={
                    es ? 'Tecnologías del proyecto' : 'Project technologies'
                  }
                >
                  {project.stack.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
                {project.links.length > 0 && (
                  <div class="project-links">
                    {project.links.map((link) => (
                      <a class="text-link" href={link.url}>
                        {link.label}
                        <Arrow diagonal />
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <div class="project-visual">
                <ProjectVisual kind={project.visual} locale={locale} />
                <span class="concept-label">
                  {es ? 'Ilustración conceptual' : 'Concept illustration'}
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        id="stack"
        class="toolkit-section section wrap"
        aria-labelledby="toolkit-title"
      >
        <div class="section-marker">
          <span aria-hidden="true">03 /</span>
          <p class="eyebrow">{t.toolkit.eyebrow}</p>
        </div>
        <h2 id="toolkit-title">{t.toolkit.title}</h2>
        <div class="toolkit-grid">
          {t.toolkit.groups.map((group, i) => (
            <div class="toolkit-group">
              <span class="toolkit-symbol" aria-hidden="true">
                {['{ }', '</>', '◫', '↗'][i]}
              </span>
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <section
        id="contact"
        class="contact-section section"
        aria-labelledby="contact-title"
      >
        <div class="contact-glow" aria-hidden="true"></div>
        <div class="wrap contact-inner">
          <div class="section-marker">
            <span aria-hidden="true">04 /</span>
            <p class="eyebrow">{t.contact.eyebrow}</p>
          </div>
          <h2 id="contact-title">
            {es ? 'Hablemos' : 'Let’s build'}
            <br />
            <span>
              {es ? 'de tu próximo proyecto.' : 'something meaningful.'}
            </span>
          </h2>
          <p>{t.contact.body}</p>
          <!--email_off-->
          <a
            class="email-link"
            href={`mailto:${profile.email}`}
            aria-label={`${t.contact.emailLabel}: ${profile.email}`}
          >
            {profile.email}
            <Arrow diagonal />
          </a>
          <!--/email_off-->
          <div class="social-links">
            <a class="text-link" href={profile.github}>
              GitHub
              <Arrow diagonal />
            </a>
            <a class="text-link" href={profile.linkedin}>
              LinkedIn
              <Arrow diagonal />
            </a>
          </div>
        </div>
      </section>
      <section
        id="support"
        class="support-section"
        aria-labelledby="support-title"
      >
        <div class="wrap support-inner">
          <p class="eyebrow" id="support-title">
            {es ? 'Apoyo institucional' : 'Institutional support'}
          </p>
          <div>
            <img
              class="support-logo"
              src="/institutional/junta-andalucia-horizontal.png"
              alt="Junta de Andalucía"
              width="1200"
              height="338"
              loading="lazy"
            />
            <p>{t.support.body}</p>
            <p class="support-note">{t.support.disclaimer}</p>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap site-footer">
      <p>© {year} Anton Andropov</p>
      <span>{t.footer.note}</span>
      <a class="text-link" href="#top">
        {t.footer.backToTop}
        <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </div>
  <script>
    const known = new Set([
      '#top',
      '#about',
      '#work',
      '#stack',
      '#contact',
      '#support',
    ]);
    function updateLanguageLinks() {
      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        '[data-language]',
      )) {
        link.hash = known.has(location.hash) ? location.hash : '';
      }
    }
    updateLanguageLinks();
    window.addEventListener('hashchange', updateLanguageLinks);
  </script>
</BaseLayout>
